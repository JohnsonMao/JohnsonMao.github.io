---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, type Locale } from '@/i18n';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	slug: string;
	locale?: string;
	langBadge?: string;
	readingTimeLabel?: string;
	tags?: string[];
	pageLocale?: Locale;
}

const { 
	title, 
	description, 
	pubDate, 
	slug, 
	locale = defaultLocale, 
	langBadge, 
	readingTimeLabel, 
	tags, 
	pageLocale = defaultLocale 
} = Astro.props;

// Use built-in Intl to format dates based on the entry's locale
const formattedDate = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(pubDate);

// Use Astro's built-in i18n helper to generate URLs.
// It automatically handles the default locale prefix based on your config.
const href = getRelativeLocaleUrl(pageLocale, `blog/${slug}`);
const tagBase = getRelativeLocaleUrl(pageLocale, 'tag/');
---

<article class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 hover:border-gray-300 dark:hover:border-gray-700 transition-colors">
	<a href={href} class="block">
		<div class="flex items-center gap-2 flex-wrap">
			<h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{title}</h2>
			{langBadge && (
				<span class="rounded px-1.5 py-0.5 text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300" aria-label={`Language: ${langBadge}`}>
					{langBadge}
				</span>
			)}
		</div>
		<p class="mt-1 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{description}</p>
		<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-500">
			<time datetime={pubDate.toISOString()}>{formattedDate}</time>
			{readingTimeLabel && <span aria-label="Reading time">{readingTimeLabel}</span>}
		</div>
	</a>
	{tags && tags.length > 0 && pageLocale != null && (
		<div class="mt-2 flex flex-wrap gap-1">
			{tags.map((tag) => (
				<a href={`${tagBase}${encodeURIComponent(tag)}`} class="rounded px-1.5 py-0.5 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700">{tag}</a>
			))}
		</div>
	)}
</article>
