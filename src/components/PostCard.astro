---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { defaultLocale, getLocale, t } from '@/i18n'

interface Props {
  title?: string
  description?: string
  pubDate?: Date
  slug?: string
  postLang?: string
  langBadge?: string
  readingTimeLabel?: string
  tags?: string[]
  /**
   * When true, renders as a client-side template for InfiniteScrollUI.
   * Outputs the same HTML structure but with `data-infinite-*` binding
   * attributes instead of actual content — place inside a `<template>` element.
   * Note: `langBadge` is not included in template mode (not available in fetched data).
   */
  asTemplate?: boolean
}

const {
  title = '',
  description = '',
  pubDate,
  slug = '',
  postLang = defaultLocale,
  langBadge,
  readingTimeLabel,
  tags,
  asTemplate = false,
} = Astro.props

const locale = getLocale(Astro.currentLocale)
const formattedDate = !asTemplate && pubDate
  ? new Intl.DateTimeFormat(postLang, { dateStyle: 'long' }).format(pubDate)
  : ''

const href = asTemplate ? '' : getRelativeLocaleUrl(locale, `blog/${slug}`)
const tagBase = getRelativeLocaleUrl(locale, 'tag/')
const blogBase = getRelativeLocaleUrl(locale, 'blog/')
---

<article
  class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 hover:border-gray-300 dark:hover:border-gray-700 transition-colors"
>
  <a
    href={href}
    class="block"
    data-infinite-href={asTemplate ? `${blogBase}{id}` : undefined}
  >
    <div class="flex items-center gap-2 flex-wrap">
      <h2
        class="text-lg font-semibold text-gray-900 dark:text-gray-100"
        data-infinite-text={asTemplate ? 'title' : undefined}
      >{asTemplate ? '' : title}</h2>
      {
        !asTemplate && langBadge && (
          <span
            class="rounded px-1.5 py-0.5 text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300"
          >
            {langBadge}
          </span>
        )
      }
    </div>
    <p
      class="mt-1 text-sm text-gray-600 dark:text-gray-400 line-clamp-2"
      data-infinite-text={asTemplate ? 'description' : undefined}
    >{asTemplate ? '' : description}</p>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-500">
      <time
        datetime={asTemplate ? undefined : pubDate?.toISOString()}
        data-infinite-date={asTemplate ? 'pubDate' : undefined}
      >{asTemplate ? '' : formattedDate}</time>
      {asTemplate
        ? <span data-infinite-text="readingTime" data-infinite-if="readingTime"></span>
        : readingTimeLabel && <span>{readingTimeLabel}</span>}
    </div>
  </a>
  {asTemplate
    ? (
        <div
          class="mt-2 flex flex-wrap gap-1"
          data-infinite-list="tags"
          data-list-template="tag-template"
          data-list-href={`${tagBase}{value}`}
        >
        </div>
      )
    : tags && tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1">
          {tags.map(tag => (
            <a
              href={`${tagBase}${tag}`}
              class="rounded px-1.5 py-0.5 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700"
            >
              {t(locale, `tags.registry.${tag}.name`)}
            </a>
          ))}
        </div>
      )}
</article>
