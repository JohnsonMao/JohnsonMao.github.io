---
import { getLocale, t } from '@/i18n'
import PushNotificationButton from './pwa/PushNotificationButton.astro'

const locale = getLocale(Astro.currentLocale)
const year = new Date().getFullYear()
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-auto">
  <div
    class="mx-auto max-w-3xl px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400 flex flex-col items-center gap-4"
  >
    <PushNotificationButton />
    <div>
      {t(locale, 'footer.copyright', { year: String(year) })}
    </div>
  </div>
</footer>
