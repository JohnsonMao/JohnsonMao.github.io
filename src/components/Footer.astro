---
import { t } from '@/i18n';

interface Props {
	locale?: 'en' | 'zh-TW';
}
const locale = (Astro.props.locale ?? 'zh-TW') as 'en' | 'zh-TW';
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-auto">
	<div class="mx-auto max-w-3xl px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400">
		{t(locale, 'footer.copyright', { year: String(year) })}
	</div>
</footer>
