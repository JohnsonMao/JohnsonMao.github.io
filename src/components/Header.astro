---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '@/i18n';

interface Props {
	locale?: 'en' | 'zh-TW';
}
const locale = (Astro.props.locale ?? 'zh-TW') as 'en' | 'zh-TW';
const homeUrl = getRelativeLocaleUrl(locale, '');
const blogUrl = getRelativeLocaleUrl(locale, 'blog');
const otherLocale = locale === 'en' ? 'zh-TW' : 'en';
const pathWithoutLocale = Astro.url.pathname.replace(/^\//, '').replace(/^en\//, '');
const otherLocaleUrl = getRelativeLocaleUrl(otherLocale, pathWithoutLocale || undefined);
---

<header class="border-b border-gray-200 dark:border-gray-800">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4" aria-label="Main">
		<a href={homeUrl} class="text-lg font-medium">{t(locale, 'nav.home')}</a>
		<a href={blogUrl} class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">{t(locale, 'nav.blog')}</a>
		<a href={otherLocaleUrl} class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" aria-label="Switch language">
			{locale === 'en' ? t(locale, 'locale.zhTW') : t(locale, 'locale.en')}
		</a>
	</nav>
</header>
