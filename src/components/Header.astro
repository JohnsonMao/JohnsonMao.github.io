---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, locales } from '@/i18n';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
	locale?: 'en' | 'zh-TW';
}
const locale = (Astro.props.locale ?? 'zh-TW') as 'en' | 'zh-TW';

// Common links
const homeUrl = getRelativeLocaleUrl(locale, '');
const blogUrl = getRelativeLocaleUrl(locale, 'blog');

// Dynamic path logic for language switcher
const currentPath = Astro.url.pathname;

/**
 * Remove any existing locale prefix from the current path
 * to get the pure route part.
 */
function getPathWithoutLocale(path: string) {
	const parts = path.split('/').filter(Boolean);
	if (parts.length > 0 && locales.includes(parts[0] as any)) {
		return '/' + parts.slice(1).join('/');
	}
	return path;
}

const baseRoute = getPathWithoutLocale(currentPath);

// Find the next locale to switch to (cycling through all defined locales)
const currentIndex = locales.indexOf(locale);
const nextLocale = locales[(currentIndex + 1) % locales.length];
const nextLocaleUrl = getRelativeLocaleUrl(nextLocale, baseRoute === '/' ? undefined : baseRoute.slice(1));
const nextLocaleLabel = t(locale, `locale.${nextLocale === 'zh-TW' ? 'zhTW' : 'en'}`);
---

<header class="border-b border-gray-200 dark:border-gray-800">
	<nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4" aria-label="Main">
		<a href={homeUrl} class="text-lg font-medium">{t(locale, 'nav.home')}</a>
		<a href={blogUrl} class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">{t(locale, 'nav.blog')}</a>
		<div class="flex items-center gap-2">
			<ThemeToggle />
			<a href={nextLocaleUrl} class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" aria-label="Switch language">
				{nextLocaleLabel}
			</a>
		</div>
	</nav>
</header>
