---
import author from '@/data/author.json'
import { getLocale } from '@/i18n'

const locale = getLocale(Astro.currentLocale)
const bio = author.bio[locale]
---

<section class="mt-12 py-8 border-t border-gray-200 dark:border-gray-800">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
    <img src={author.avatar} alt={author.name} class="w-24 h-24 rounded-full object-cover shadow-md" />
    <div class="flex-1 text-center sm:text-left">
      <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        {author.name}
      </h3>
      <p class="text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">
        {bio}
      </p>
      <div class="flex justify-center sm:justify-start gap-4">
        {
          author.social.github && (
            <a
              href={author.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors"
              title="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
