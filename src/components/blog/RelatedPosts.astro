---
import PostCard from '@/components/PostCard.astro';
import { getReadingTime } from '@/utils/reading-time';
import type { LocalizedCollection } from '@/utils/content';

interface Props {
	posts: LocalizedCollection<'blog'>[];
	title: string;
}

const { posts, title } = Astro.props;

if (posts.length === 0) return null;
---

<section class="mt-16 border-t border-gray-100 dark:border-gray-800 pt-12 not-prose">
	<h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8">{title}</h2>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		{posts.map((post) => {
			const readingTime = getReadingTime(post.body ?? '', post.locale);
			return (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					slug={post.id}
					postLang={post.locale}
					readingTimeLabel={readingTime.label}
					tags={post.data.tags}
				/>
			);
		})}
	</div>
</section>
