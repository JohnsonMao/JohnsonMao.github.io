---
import { t, getLocale } from '@/i18n';

interface Props {
	title: string;
	url: string;
}

const { title, url } = Astro.props;
const locale = getLocale(Astro.currentLocale);

const shareLinks = [
	{
		name: 'Twitter',
		icon: 'Twitter',
		url: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
		color: 'hover:text-blue-400',
        svg: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>'
	},
	{
		name: 'Threads',
		icon: 'Threads',
		url: `https://www.threads.net/intent/post?text=${encodeURIComponent(title + ' ' + url)}`,
		color: 'hover:text-black dark:hover:text-white',
        svg: '<path d="M14.665,11.391c-0.126-1.234-0.89-2.33-2.046-3.003C11.399,7.674,9.929,7.587,8.604,8.14 c-1.325,0.553-2.221,1.729-2.525,3.313c-0.344,1.791,0.22,3.568,1.547,4.872c1.328,1.304,3.134,1.968,4.954,1.821 c1.821-0.147,3.463-1.11,4.505-2.639c0.232-0.34,0.141-0.803-0.203-1.033c-0.344-0.23-0.814-0.138-1.046,0.203 c-0.793,1.163-2.043,1.897-3.429,2.008c-1.385,0.111-2.759-0.395-3.77-1.389c-1.011-0.994-1.442-2.348-1.179-3.714 c0.231-1.205,0.912-2.1,1.921-2.521c1.01-0.421,2.129-0.355,3.056,0.185c0.88,0.512,1.464,1.345,1.56,2.282 c0.049,0.485,0.48,0.835,0.963,0.787C14.444,12.283,14.714,11.875,14.665,11.391z M12.001,3.429c-4.735,0-8.572,3.837-8.572,8.572 s3.837,8.572,8.572,8.572s8.572-3.837,8.572-8.572S16.736,3.429,12.001,3.429z M12.001,1.714C17.681,1.714,22.286,6.319,22.286,12 c0,5.681-4.605,10.286-10.286,10.286S1.714,17.681,1.714,12C1.714,6.319,6.319,1.714,12.001,1.714z"/>'
	},
	{
		name: 'Facebook',
		icon: 'Facebook',
		url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
		color: 'hover:text-blue-600',
        svg: '<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>'
	},
];
---

<div class="flex flex-col gap-4 my-8">
	<span class="text-sm font-semibold text-gray-500 uppercase tracking-wider">
		{t(locale, 'blog.share')}
	</span>
	<div class="flex gap-4">
		{shareLinks.map((link) => (
			<a
				href={link.url}
				target="_blank"
				rel="noopener noreferrer"
				class={`p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 transition-all ${link.color} hover:scale-110`}
				title={`Share on ${link.name}`}
			>
				<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" set:html={link.svg}></svg>
			</a>
		))}
	</div>
</div>
