---
import type { HTMLAttributes } from 'astro/types'
import { Icon } from 'astro-icon/components'

type Props = HTMLAttributes<'div'>

const props: Props = Astro.props
---

<theme-toggle
  aria-label="Toggle theme"
  {...props}
  class:list={[
    'rounded p-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors',
    props.class,
  ]}
>
  <Icon name="lucide:sun" class="w-5 h-5 hidden dark:block" aria-hidden="true" />
  <Icon name="lucide:moon" class="w-5 h-5 block dark:hidden" aria-hidden="true" />
</theme-toggle>

<script>
class ThemeToggle extends HTMLElement {
  readonly THEME_STORAGE_KEY = 'theme'

  readonly THEMES = {
    LIGHT: 'light',
    DARK: 'dark',
  } as const

  get theme() {
    return localStorage.getItem(this.THEME_STORAGE_KEY)
  }

  applyTheme(theme: string) {
    document.documentElement.classList.toggle(this.THEMES.DARK, theme === this.THEMES.DARK)
  }

  set theme(value: string | null) {
    if (value) {
      localStorage.setItem(this.THEME_STORAGE_KEY, value)
      this.applyTheme(value)
    }
    else {
      localStorage.removeItem(this.THEME_STORAGE_KEY)
    }
  }

  connectedCallback() {
    if (this.getAttribute('tabindex') === null)
      this.setAttribute('tabindex', '0')

    if (this.getAttribute('role') === null)
      this.setAttribute('role', 'button')

    this.handleToggle = this.handleToggle.bind(this)
    this.handleKeydown = this.handleKeydown.bind(this)
    this.addEventListener('click', this.handleToggle)
    this.addEventListener('keydown', this.handleKeydown)

    // Apply theme from localStorage on initial load or fallback to system preference
    if (this.theme) {
      this.applyTheme(this.theme)
    }
    else {
      // Fallback to system preference if no theme is stored
      const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches
      this.applyTheme(prefersDark ? this.THEMES.DARK : this.THEMES.LIGHT)
    }
  }

  handleToggle() {
    const current = document.documentElement.classList.contains(this.THEMES.DARK) ? this.THEMES.DARK : this.THEMES.LIGHT
    this.theme = current === this.THEMES.DARK ? this.THEMES.LIGHT : this.THEMES.DARK
  }

  handleKeydown(event: KeyboardEvent) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault()
      this.handleToggle()
    }
  }
}

if (!customElements.get('theme-toggle')) {
  customElements.define('theme-toggle', ThemeToggle)
}
</script>
