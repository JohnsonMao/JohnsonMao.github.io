---
import { ClientRouter } from 'astro:transitions';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '@/i18n';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	locale?: 'en' | 'zh-TW';
}
const locale = (Astro.props.locale ?? 'zh-TW') as 'en' | 'zh-TW';
const { title, description = t(locale, 'home.description') } = Astro.props;
const pathWithoutLocale = Astro.url.pathname.replace(/^\//, '').replace(/^en\//, '');
const locales = ['zh-TW', 'en'] as const;
const site = Astro.site?.href ?? `${Astro.url.origin}/`;
---

<html lang={locale}>
	<head>
		<ClientRouter />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{locales.map((loc) => {
			const path = getRelativeLocaleUrl(loc, pathWithoutLocale || undefined);
			const href = new URL(path, site).href;
			return <link rel="alternate" hreflang={loc === 'zh-TW' ? 'zh-Hant' : loc} href={href} />;
		})}
		<link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('zh-TW', pathWithoutLocale || undefined), site).href} />
	</head>
	<body class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100">
		<Header locale={locale} />
		<main class="flex-1 mx-auto w-full max-w-3xl px-4 py-8">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
