---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'
import AuthorBio from '@/components/blog/AuthorBio.astro'
import Giscus from '@/components/blog/Giscus.astro'
import ReadingProgress from '@/components/blog/ReadingProgress.astro'
import RelatedPosts from '@/components/blog/RelatedPosts.astro'
import SeriesNav from '@/components/blog/SeriesNav.astro'
import SharePanel from '@/components/blog/SharePanel.astro'
import TableOfContents from '@/components/blog/TableOfContents.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { defaultLocale, getLocale, t } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { LocalizedCollection } from '@/utils/content'
import { getCollectionEntry, getRelatedEntries } from '@/utils/content'

interface Props {
  id: string
  title: string
  description?: string
  pubDate: Date
  postLang?: string
  isFallback?: boolean
  fallbackNotice?: string
  image?: string
  canonical?: string
  readingTimeLabel?: string
  updated?: Date
  tags?: string[]
  headings?: MarkdownHeading[]
  relatedPosts?: LocalizedCollection<'blog'>[]
  collection: 'blog' | 'notes'
}

const {
  id,
  title,
  description,
  pubDate,
  postLang = defaultLocale,
  isFallback,
  fallbackNotice,
  image,
  canonical,
  readingTimeLabel,
  updated,
  tags,
  headings = [],
  relatedPosts: propRelatedPosts,
  collection,
} = Astro.props

const locale = getLocale(Astro.currentLocale)

// Use the dynamically generated OG image unless the post provides a custom one
const ogImage = image ?? `/og/${locale}/blog/${id}.png`

const formattedDate = new Intl.DateTimeFormat(postLang, { dateStyle: 'long' }).format(pubDate)
const formattedUpdated = updated ? new Intl.DateTimeFormat(postLang, { dateStyle: 'long' }).format(updated) : null
const showUpdated = updated && updated.getTime() !== pubDate.getTime()

const tagBase = getRelativeLocaleUrl(locale, 'tag/')

const breadcrumbs = [
  {
    name: t(locale, 'nav.home'),
    url: new URL(getRelativeLocaleUrl(locale, '/'), Astro.site).href,
  },
  {
    name: t(locale, `nav.${collection}`),
    url: new URL(getRelativeLocaleUrl(locale, `${collection}/`), Astro.site).href,
  },
  {
    name: title,
    url: Astro.url.href,
  },
]

let entry: LocalizedCollection<'blog'> | undefined
let relatedPosts: LocalizedCollection<'blog'>[]

if (propRelatedPosts !== undefined) {
  // External override: skip blog fetch (e.g., for notes pages)
  relatedPosts = propRelatedPosts
}
else {
  entry = await getCollectionEntry('blog', locale, id)
  relatedPosts = await getRelatedEntries('blog', entry)
}

const postData = {
  title,
  description,
  pubDate,
  updated,
  image,
}
---

<BaseLayout title={title} description={description} image={ogImage} canonical={canonical} maxWidth="max-w-6xl">
  <JsonLd slot="head" post={postData} url={Astro.url.href} breadcrumbs={breadcrumbs} />
  <ReadingProgress targetId="post-content" />
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-12 items-start">
    <article class="prose dark:prose-invert max-w-none min-w-0" data-pagefind-body>
      {
        isFallback && fallbackNotice && (
          <div
            id="fallback-banner"
            class="mb-8 rounded-xl border border-amber-200 bg-amber-50/50 p-4 text-sm text-amber-900 dark:border-amber-800/50 dark:bg-amber-950/20 dark:text-amber-200 backdrop-blur-sm"
            role="status"
            aria-live="polite"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400">
                <Icon name="lucide:info" class="w-4 h-4" />
              </span>
              <p class="font-medium">{fallbackNotice}</p>
            </div>
          </div>
        )
      }

      <header class="mb-10 not-prose">
        <h1
          class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-4 leading-tight"
          data-pagefind-weight="10"
        >
          {title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
          <div class="flex items-center gap-1.5">
            <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          </div>
          {
            readingTimeLabel && (
              <div class="flex items-center gap-1.5">
                <Icon name="lucide:clock" class="w-3.5 h-3.5" />
                <span>{readingTimeLabel}</span>
              </div>
            )
          }
        </div>
        {
          showUpdated && formattedUpdated && (
            <p class="mt-2 text-xs text-muted-foreground/80 italic">
              {t(locale, 'blog.updatedOn')} <time datetime={updated.toISOString()}>{formattedUpdated}</time>
            </p>
          )
        }
        {
          tags && tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map(tag => (
                <a
                  href={`${tagBase}${tag}`}
                  class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors border border-transparent"
                >
                  #{t(locale, `tags.registry.${tag}.name`)}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div id="post-content" class="prose-headings:font-bold prose-a:text-primary hover:prose-a:underline">
        <slot />
      </div>

      {entry && <SeriesNav post={entry} />}

      <RelatedPosts posts={relatedPosts} title={t(locale, 'blog.relatedPosts')} />

      <SharePanel title={title} url={Astro.url.href} copyLabel={t(locale, 'blog.copyLink')} copiedLabel={t(locale, 'blog.copied')} />

      <AuthorBio />

      <div class="mt-12 pt-12 border-t border-dashed border-gray-200 dark:border-gray-800">
        <h2 class="text-2xl font-bold mb-4">{t(locale, 'blog.comments')}</h2>
        <Giscus />
      </div>
    </article>

    <aside class="hidden lg:block sticky top-24 self-start">
      <TableOfContents headings={headings} title={t(locale, 'blog.tableOfContents')} />
    </aside>
  </div>
</BaseLayout>
