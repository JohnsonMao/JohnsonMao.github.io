---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { t, defaultLocale, type Locale } from '@/i18n';
import { getReadingTime } from '@/utils/reading-time';
import { getEntriesByTag } from '@/utils/content';

export async function getStaticPaths() {
	const tagMap = await getEntriesByTag(defaultLocale);
	return Object.keys(tagMap).map((tag) => ({
		params: { tag: encodeURIComponent(tag) },
		props: { tag }
	}));
}

const { tag } = Astro.props;
const locale = defaultLocale;

const tagMap = await getEntriesByTag(locale);
const picked = tagMap[tag] || [];
const sorted = picked.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={`${t(locale, 'blog.listTitle')} — ${tag}`} description={t(locale, 'blog.listDescription')}>
	<div class="max-w-4xl mx-auto px-4 py-12">
		<header class="mb-12">
			<div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
				Tag
			</div>
			<h1 class="text-4xl font-bold tracking-tight mb-4">
				{tag}
			</h1>
			<p class="text-muted-foreground text-lg">
				{t(locale, 'blog.listDescription')} — {t(locale, 'nav.blog')}
			</p>
		</header>

		<ul class="grid gap-8 list-none p-0 m-0">
			{sorted.map((entry) => {
				const articleLang = entry.data.lang;
				const isFallback = articleLang !== locale;
				const localeLabelKey = (articleLang === 'en' ? 'localeLabel.en' : 'localeLabel.zhTW') as any;
				const langBadge = isFallback ? t(locale, localeLabelKey) : undefined;
				const readingTime = getReadingTime(entry.body ?? '', articleLang);
				
				return (
					<li>
						<PostCard
							title={entry.data.title}
							description={entry.data.description}
							pubDate={entry.data.pubDate}
							slug={entry.baseId}
							postLang={articleLang}
							langBadge={langBadge}
							readingTimeLabel={readingTime.label}
							tags={entry.data.tags}
						/>
					</li>
				);
			})}
		</ul>
		
		{sorted.length === 0 && (
			<div class="text-center py-24 bg-muted/30 rounded-2xl border-2 border-dashed border-muted">
				<p class="text-muted-foreground">No content found with this tag.</p>
			</div>
		)}
	</div>
</BaseLayout>
