---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { t } from '@/i18n';

export function getStaticPaths() {
	return [{ params: { locale: 'en' } }];
}
const locale = Astro.params.locale as 'en' | 'zh-TW';
const priorityOrder: ('en' | 'zh-TW')[] = locale === 'zh-TW' ? ['zh-TW', 'en'] : ['en', 'zh-TW'];
const all = await getCollection('blog', ({ data }) => data.draft !== true);
const bySlug = new Map<string, typeof all>();
for (const entry of all) {
	const slug = entry.id.includes('/') ? entry.id.split('/').slice(1).join('/') : entry.id;
	const existing = bySlug.get(slug);
	if (!existing) bySlug.set(slug, [entry]);
	else existing.push(entry);
}
const picked: (typeof all)[number][] = [];
for (const entries of bySlug.values()) {
	const chosen = priorityOrder.map((lang) => entries.find((e) => e.data.lang === lang)).find(Boolean);
	if (chosen) picked.push(chosen);
}
const sorted = picked.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={t(locale, 'blog.listTitle')} description={t(locale, 'blog.listDescription')} locale={locale}>
	<h1 class="text-2xl font-bold mb-6">{t(locale, 'blog.listTitle')}</h1>
	<ul class="space-y-4 list-none p-0 m-0">
		{sorted.map((entry) => {
			const slug = entry.id.includes('/') ? entry.id.split('/').slice(1).join('/') : entry.id;
			const articleLang = entry.data.lang;
			const langBadge = articleLang !== locale ? t(locale, articleLang === 'en' ? 'localeLabel.en' : 'localeLabel.zhTW') : undefined;
			return (
				<li>
					<PostCard
						title={entry.data.title}
						description={entry.data.description}
						pubDate={entry.data.pubDate}
						slug={slug}
						locale={articleLang}
						langBadge={langBadge}
					/>
				</li>
			);
		})}
	</ul>
</BaseLayout>
