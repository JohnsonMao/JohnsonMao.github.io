---
import { getCollection, render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { t } from '@/i18n';

export async function getStaticPaths() {
	const all = await getCollection('blog', ({ data }) => data.draft !== true);
	const slugs = new Set(all.map((e) => (e.id.includes('/') ? e.id.split('/').slice(1).join('/') : e.id)));
	return Array.from(slugs).map((slug) => ({ params: { locale: 'en', slug }, props: {} }));
}

const pageLocale = Astro.params.locale as 'en' | 'zh-TW';
const slug = Astro.params.slug as string;
const priorityOrder: ('en' | 'zh-TW')[] = ['en', 'zh-TW'];
const all = await getCollection('blog', ({ data }) => data.draft !== true);
const bySlug = all.filter((e) => (e.id.includes('/') ? e.id.split('/').slice(1).join('/') : e.id) === slug);
const entry = priorityOrder.map((lang) => bySlug.find((e) => e.data.lang === lang)).find(Boolean);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
const isFallback = entry.data.lang !== pageLocale;
---

<PostLayout title={entry.data.title} description={entry.data.description} pubDate={entry.data.pubDate} locale={entry.data.lang} pageLocale={pageLocale} isFallback={isFallback} fallbackNotice={isFallback ? t(pageLocale, 'blog.contentNotTranslated') : undefined}>
	<Content />
</PostLayout>
