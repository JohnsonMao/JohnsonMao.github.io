---
import { render } from 'astro:content'
import type { Locale } from '@/i18n'
import { defaultLocale, locales } from '@/i18n'
import PostLayout from '@/layouts/PostLayout.astro'
import type { LocalizedNote } from '@/utils/content'
import { getNotesForLocale } from '@/utils/content'

export async function getStaticPaths() {
  const all = await Promise.all(
    locales.map(async (locale: Locale) => {
      const entries = await getNotesForLocale(locale)
      const lang = locale === defaultLocale ? undefined : locale
      return entries.map((entry: LocalizedNote) => ({
        params: { lang, slug: entry.id },
        props: { entry },
      }))
    }),
  )
  return all.flat()
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
---

<PostLayout
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  postLang={entry.locale}
  updated={entry.data.updated}
  tags={entry.data.tags}
  headings={headings}
  relatedPosts={[]}
  collection="notes"
>
  <Content />
</PostLayout>
