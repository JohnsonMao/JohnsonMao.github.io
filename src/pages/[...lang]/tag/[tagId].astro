---
import PostCard from '@/components/PostCard.astro'
import { generateStaticLocalePaths, getLocale, t } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getEntriesByTag } from '@/utils/content'
import { getReadingTimeMinutes } from '@/utils/reading-time'

export async function getStaticPaths() {
  const all = await Promise.all(
    generateStaticLocalePaths().map(async (path) => {
      const locale = getLocale(path.params.lang)
      const tagMap = await getEntriesByTag(locale)
      return Array.from(tagMap.keys(), tagId => ({
        params: { ...path.params, tagId },
      }))
    }),
  )
  return all.flat()
}

const { lang, tagId } = Astro.params
const locale = getLocale(lang)

const tagMap = await getEntriesByTag(locale)
const picked = tagMap.get(tagId) || []
const sorted = picked.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const displayTag = t(locale, `tags.registry.${tagId}.name`)
const tagDescription = t(locale, `tags.registry.${tagId}.description`)
const pageDescription = tagDescription || `${t(locale, 'blog.listDescription')} — ${displayTag}`
---

<BaseLayout title={`${t(locale, 'blog.listTitle')} — ${displayTag}`} description={pageDescription}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">Tag</div>
      <h1 class="text-4xl font-bold tracking-tight mb-4">
        {displayTag}
      </h1>
      {
        tagDescription && (
          <p class="text-muted-foreground text-lg mb-4 max-w-2xl">
            {tagDescription}
          </p>
        )
      }
      <p class="text-muted-foreground text-sm">
        {t(locale, 'tags.count', { count: sorted.length.toString() })}
      </p>
    </header>

    <ul class="grid gap-8 list-none p-0 m-0">
      {
        sorted.map((entry) => {
          const articleLang = entry.locale
          const isFallback = articleLang !== locale
          const langBadge = isFallback ? t(locale, `shortLabel.${articleLang}`) : undefined
          const readingTimeMinutes = getReadingTimeMinutes(entry.body ?? '', articleLang)
          const readingTimeLabel = t(locale, 'blog.readingTime', { minutes: readingTimeMinutes })

          return (
            <li>
              <PostCard
                title={entry.data.title}
                description={entry.data.description}
                pubDate={entry.data.pubDate}
                slug={entry.id}
                postLang={articleLang}
                langBadge={langBadge}
                readingTimeLabel={readingTimeLabel}
                tags={entry.tags}
              />
            </li>
          )
        })
      }
    </ul>

    {
      sorted.length === 0 && (
        <div class="text-center py-24 bg-muted/30 rounded-2xl border-2 border-dashed border-muted">
          <p class="text-muted-foreground">No content found with this tag.</p>
        </div>
      )
    }
  </div>
</BaseLayout>
