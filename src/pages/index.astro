---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, defaultLocale } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const blogUrl = getRelativeLocaleUrl(defaultLocale, 'blog');
---

<BaseLayout title={t(defaultLocale, 'home.title')} description={t(defaultLocale, 'home.description')}>
	<div class="space-y-6">
		<h1 class="text-2xl font-bold">{t(defaultLocale, 'home.welcome')}</h1>
		<p class="text-gray-600 dark:text-gray-400">{t(defaultLocale, 'home.intro')}</p>
		<p>
			<a href={blogUrl} class="text-blue-600 dark:text-blue-400 hover:underline">{t(defaultLocale, 'home.toBlog')}</a>
		</p>
	</div>
	<script is:inline define:vars={{}}>
		(function () {
			const STORAGE_KEY = 'astro-locale';
			const preferred = typeof localStorage !== 'undefined' ? localStorage.getItem(STORAGE_KEY) : null;
			if (preferred === 'en') {
				window.location.replace('/en/');
				return;
			}
			const lang = typeof navigator !== 'undefined' && (navigator.language || navigator.languages?.[0] || '');
			const wantsEn = /^en(\b|-)/i.test(lang);
			if (wantsEn) {
				try { localStorage.setItem(STORAGE_KEY, 'en'); } catch (_) {}
				window.location.replace('/en/');
			}
		})();
	</script>
</BaseLayout>
