---
import { getCollection, render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { t, defaultLocale, getLocalePriority } from '@/i18n';
import { getReadingTime } from '@/utils/reading-time';
import { getBaseId } from '@/utils/content';

export async function getStaticPaths() {
	const all = await getCollection('blog', ({ data }) => import.meta.env.DEV || data.draft !== true);
	const slugs = Array.from(new Set(all.map((e) => getBaseId(e.id))));
	return slugs.map((slug) => ({ params: { slug }, props: {} }));
}

const { slug } = Astro.params;
const locale = defaultLocale;

const all = await getCollection('blog', ({ data }) => import.meta.env.DEV || data.draft !== true);
const bySlug = all.filter((e) => getBaseId(e.id) === slug);

// Determine priority based on the default locale
const priority = getLocalePriority(locale);
const entry = priority.map((lang) => bySlug.find((e) => e.data.lang === lang)).find(Boolean);

if (!entry) return Astro.redirect('/404');

const { Content, headings } = await render(entry);
const isFallback = entry.data.lang !== locale;
const readingTime = getReadingTime(entry.body ?? '', entry.data.lang);
---

<PostLayout
	id={entry.id}
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	locale={entry.data.lang}
	pageLocale={locale}
	isFallback={isFallback}
	fallbackNotice={isFallback ? t(locale, 'blog.contentNotTranslated') : undefined}
	readingTimeLabel={readingTime.label}
	updated={entry.data.updated}
	tags={entry.data.tags}
	headings={headings}
>
	<Content />
</PostLayout>
